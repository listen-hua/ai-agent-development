APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_URL=http://127.0.0.1:8088
SESSION_SECRET=change-me-to-at-least-32-characters
# 用于加密后台保存的各 Agent API Key；生产启用后不要随意修改，否则旧密钥无法解密。
AGENT_SECRET_ENCRYPTION_KEY=change-me-agent-key-encryption-secret
DEV_AUTH_ENABLED=true
DATABASE_URL=postgres://ai_agent:ai_agent@postgres:5432/ai_agent?sslmode=disable
REDIS_ADDR=redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=ai-agent-documents
MINIO_SECURE=false
TIKA_URL=http://tika:9998
OCR_URL=http://paddleocr:8866
CLAMAV_ADDR=clamav:3310
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8088/
FEISHU_APP_LINK=
# 可留空并在“会议室管理”页面初始化；也可填写应用身份已有的共享日历 ID。
FEISHU_MEETING_CALENDAR_ID=
# 首位正式超级管理员的 open_id，可配置多个并用英文逗号分隔；完成后台授权后建议清空。
BOOTSTRAP_SUPER_ADMIN_OPEN_IDS=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_GENERATION_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_CONTEXT_MODEL=qwen-flash
DASHSCOPE_REMINDER_MODEL=qwen-flash
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_POLL_SECONDS=5
REMINDER_GRACE_MINUTES=30
REMINDER_MAX_ACTIVE_PER_USER=100
RETENTION_DAYS=90
